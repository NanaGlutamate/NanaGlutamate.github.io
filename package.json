{
  "name": "homepage",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "python scripts/download-avatar.py && astro build",
    "build:denoise": "node scripts/build-denoise.mjs",
    "preview": "astro preview",
    "fetch": "python scripts/fetch-posts.py",
    "build:debug": "node -e \"process.env.BLOG_INCLUDE_TEST='true';require('child_process').execSync('astro build',{stdio:'inherit'})\"",
    "build:preview": "node -e \"process.env.BLOG_INCLUDE_TEST='true';let e=require('child_process');e.execSync('astro build',{stdio:'inherit'});e.execSync('astro preview',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/maple-mono": "^5.3.0",
    "astro": "^7.1.3",
    "katex": "^0.16.47",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
