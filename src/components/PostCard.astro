---
import { formatDate } from '../lib/date'

export interface Props {
  slug: string
  title: string
  date: string | null
  series: string | null
  tags: { name: string }[]
  summary?: string
  showSeries?: boolean
}

const { slug, title, date, series, tags, summary, showSeries = true } = Astro.props

const metaParts: string[] = []
if (date) metaParts.push(formatDate(date))
if (showSeries && series) metaParts.push(series)
tags.slice(0, 4).forEach((tag) => metaParts.push(tag.name))
---

<div class="post-card">
  <a href={`/posts/${slug}`} class="post-card-overlay" aria-label={title.trim()}></a>
  <h2 class="post-card-title">{title.trim()}</h2>
  {metaParts.length > 0 && (
    <div class="post-card-meta">
      {metaParts.map((part, i) => {
        const isSeries = showSeries && series === part
        return (
          <>{i > 0 && <span class="post-card-meta-sep">·</span>}
          {isSeries ? (
            <a href={`/series/${series}`} class="post-card-series inline-flex items-center gap-1 hover:text-[var(--accent)] transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              {part}
            </a>
          ) : (
            <span>{part}</span>
          )}
          </>
        )
      })}
    </div>
  )}
  {summary && (
    <p class="post-card-summary line-clamp-2">{summary}</p>
  )}
</div>
