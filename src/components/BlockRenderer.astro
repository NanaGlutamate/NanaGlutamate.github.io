---
import katex from 'katex'
import 'katex/dist/katex.min.css'

interface Props {
  blocks: any[]
}

const { blocks } = Astro.props

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
}

function renderKatex(expression: string, displayMode = true): string {
  try {
    return katex.renderToString(expression, { displayMode, throwOnError: false })
  } catch {
    return `<span class="text-red-500">KaTeX Error: ${escapeHtml(expression)}</span>`
  }
}

function notionPageIdFromHref(href: string): string | null {
  const m = href.match(/^\/(?:p\/)?([0-9a-f]{8}[0-9a-f]{4}[0-9a-f]{4}[0-9a-f]{4}[0-9a-f]{12})(?:[#?]|$)/i)
  return m ? m[1] : null
}

function subPageAnchor(pageId: string): string {
  const stripped = pageId.replace(/-/g, '')
  return `sub-page-${stripped.substring(0, 12)}`
}

function renderRichText(richText: any[]): string {
  if (!richText || richText.length === 0) return ''
  return richText.map((item) => {
    let text = escapeHtml(item.plain_text || '').replace(/\n/g, '<br>')
    const ann = item.annotations || {}

    if (ann.bold) text = `<strong>${text}</strong>`
    if (ann.italic) text = `<em>${text}</em>`
    if (ann.strikethrough) text = `<del>${text}</del>`
    if (ann.code) text = `<code>${text}</code>`

    if (item.type === 'equation' && item.expression) {
      return renderKatex(item.expression, false)
    }

    if (item.type === 'mention' && item.mention_type === 'page') {
      const slug = item.page_id || ''
      if (slug) return `<a href="/posts/${escapeHtml(slug)}" class="in-site-link">${text}</a>`
    }

    let href = item.href || ''
    if (href && notionPageIdFromHref(href)) {
      const stripped = notionPageIdFromHref(href)!
      return `<a href="#${subPageAnchor(stripped)}" class="in-site-link">${text}</a>`
    }

    if (href && href.startsWith('/')) {
      return `<a href="${escapeHtml(href)}" class="in-site-link">${text}</a>`
    }

    if (href) {
      text = `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">${text}</a>`
    }

    return text
  }).join('')
}

function renderPlainText(richText: any[]): string {
  if (!richText || richText.length === 0) return ''
  return richText.map((item) => escapeHtml(item.plain_text || '')).join('')
}

function renderRegularCallout(block: any): string {
  const emoji = block.emoji || '💡'
  const rt = renderRichText(block.rich_text)
  const childHtml = block.children
    ? `<div class="child-blocks mt-1.5">${blocksToHtml(block.children)}</div>`
    : ''
  return `<div class="callout-box"><span class="callout-box-emoji">${emoji}</span><div class="flex-1 min-w-0">${rt}${childHtml}</div></div>`
}

function renderSidenoteCallout(block: any): string {
  const emoji = block.emoji || '💡'
  const rt = renderRichText(block.rich_text)
  const childHtml = block.children
    ? `<div class="child-blocks">${blocksToHtml(block.children)}</div>`
    : ''
  return `<aside class="sidenote hidden xl:block"><span class="sidenote-emoji">${emoji}</span>${rt}${childHtml}</aside>`
}

function renderInlineCallout(block: any): string {
  const emoji = block.emoji || '💡'
  const rt = renderRichText(block.rich_text)
  const childHtml = block.children
    ? `<div class="child-blocks mt-1.5">${blocksToHtml(block.children)}</div>`
    : ''
  return `<div class="callout-inline xl:hidden"><span class="sidenote-emoji">${emoji}</span><div class="flex-1 min-w-0">${rt}${childHtml}</div></div>`
}

function renderChildrenWithSidenote(parentHtml: string, children: any[]): string {
  if (!children || children.length === 0) return parentHtml
  if (children[0]?.type !== 'callout') {
    return parentHtml + `<div class="child-blocks">${blocksToHtml(children)}</div>`
  }
  const sidenoteCallout = children[0]
  const restChildren = children.slice(1)
  const restHtml = restChildren.length > 0
    ? `<div class="child-blocks">${blocksToHtml(restChildren)}</div>`
    : ''
  return `<div class="block-with-sidenote">${renderSidenoteCallout(sidenoteCallout)}<div class="sidenote-target-group">${parentHtml}${restHtml}</div>${renderInlineCallout(sidenoteCallout)}</div>`
}

let hCounter = 0
let currentSectionId = ''

function blockToHtml(block: any): string {
  const { type } = block

  switch (type) {
    case 'paragraph': {
      const rt = renderRichText(block.rich_text)
      if (!rt.trim()) {
        if (block.children) return blocksToHtml(block.children)
        return '<br />'
      }
      const contentHtml = `<p>${rt}</p>`
      if (block.children) {
        return renderChildrenWithSidenote(contentHtml, block.children)
      }
      return contentHtml
    }
    case 'heading_1':
    case 'heading_2':
    case 'heading_3': {
      const level = parseInt(type.split('_')[1])
      const rt = renderRichText(block.rich_text)
      if (!rt) return ''
      hCounter++
      const id = `h-${hCounter}`
      const contentHtml = `<h${level} id="${id}">${rt}</h${level}>`
      if (block.children) {
        return renderChildrenWithSidenote(contentHtml, block.children)
      }
      return contentHtml
    }
    case 'code': {
      const rawCode = (block.rich_text || []).map((item: any) => item.plain_text || '').join('')
      const lang = (block.language || '').trim()
      const langLabel = lang || 'plain text'
      const lines = rawCode.split('\n')
      let lineRows = ''
      for (let i = 0; i < lines.length; i++) {
        lineRows += `<tr><td class="code-ln">${i + 1}</td><td class="code-lc">${escapeHtml(lines[i])}</td></tr>`
      }
      const copySvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`
      if (lang === 'mermaid') {
        const toggleSvg = `<svg class="toggle-icon-code" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg><svg class="toggle-icon-chart" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`
        return `<div class="code-block mermaid-block" data-code="${escapeHtml(rawCode)}"><div class="code-header"><span class="code-lang">${escapeHtml(langLabel)}</span><div class="code-actions"><button class="toggle-mermaid" title="Toggle view">${toggleSvg}</button><button class="copy-code" title="Copy code">${copySvg}</button></div></div><div class="code-divider"></div><div class="mermaid-render"><pre class="mermaid">${rawCode}</pre></div><div class="code-body" style="display:none"><table class="code-table">${lineRows}</table></div></div>`
      }
      return `<div class="code-block" data-code="${escapeHtml(rawCode)}"><div class="code-header"><span class="code-lang">${escapeHtml(langLabel)}</span><button class="copy-code" title="Copy code">${copySvg}</button></div><div class="code-divider"></div><div class="code-body"><table class="code-table">${lineRows}</table></div></div>`
    }
    case 'equation': {
      const expr = block.expression || ''
      return `<div class="equation-wrapper" data-equation="${escapeHtml(expr)}"><div class="equation-scroll">${renderKatex(expr, true)}</div><button class="copy-latex" title="Copy LaTeX"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>`
    }
    case 'divider':
      return '<hr />'
    case 'image':
    case 'video':
    case 'file':
    case 'pdf': {
      const src = escapeHtml(block.src || '')
      const caption = block.caption ? renderRichText(block.caption) : ''
      if (!src) return ''
      if (type === 'video') {
        return `<video src="${src}" controls class="rounded-lg max-w-full my-4"></video>${caption}`
      }
      if (type === 'file' || type === 'pdf') {
        const filename = src.split('/').pop() || src
        const fileSvg = type === 'pdf'
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>'
        return `<div class="my-3"><span class="inline-flex items-center gap-1.5">${fileSvg}<a href="${src}" target="_blank" rel="noopener noreferrer" download class="in-site-link">${escapeHtml(filename)}</a></span></div>`
      }
      const alt = caption.replace(/<[^>]*>/g, '') || 'image'
      return `<img src="${src}" alt="${escapeHtml(alt)}" loading="lazy" />${caption}`
    }
    case 'callout': {
      return renderRegularCallout(block)
    }
    case 'quote': {
      const rt = renderRichText(block.rich_text)
      const childHtml = block.children
        ? `<div class="child-blocks">${blocksToHtml(block.children)}</div>`
        : ''
      return `<blockquote>${rt}${childHtml}</blockquote>`
    }
    case 'bulleted_list_item': {
      const rt = renderRichText(block.rich_text)
      const childHtml = block.children
        ? `<ul>${blocksToHtml(block.children)}</ul>`
        : ''
      return `<li>${rt}${childHtml}</li>`
    }
    case 'numbered_list_item': {
      const rt = renderRichText(block.rich_text)
      const childHtml = block.children
        ? `<ol>${blocksToHtml(block.children)}</ol>`
        : ''
      return `<li>${rt}${childHtml}</li>`
    }
    case 'toggle': {
      const rt = renderRichText(block.rich_text)
      const childHtml = block.children
        ? `<div class="toggle-content">${blocksToHtml(block.children)}</div>`
        : ''
      return `<details class="toggle-block"><summary>${rt}</summary>${childHtml}</details>`
    }
    case 'bookmark': {
      const caption = renderRichText(block.caption || [])
      const url = escapeHtml(block.url || '#')
      return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="bookmark-card block no-underline!"><div class="text-sm text-[var(--text-secondary)]">🔗 ${caption || url}</div></a>`
    }
    case 'column_list': {
      const childHtml = block.children ? blocksToHtml(block.children) : ''
      return `<div class="column-list">${childHtml}</div>`
    }
    case 'column': {
      const childHtml = block.children ? blocksToHtml(block.children) : ''
      return `<div class="column">${childHtml}</div>`
    }
    case 'to_do': {
      const checked = block.checked ? 'checked' : ''
      const rt = renderRichText(block.rich_text)
      const childHtml = block.children
        ? `<div class="child-blocks">${blocksToHtml(block.children)}</div>`
        : ''
      return `<div class="flex items-center gap-2 my-1"><input type="checkbox" ${checked} disabled class="rounded" /><span class="${block.checked ? 'line-through text-[var(--text-muted)]' : ''}">${rt}</span></div>${childHtml}`
    }
    case 'table': {
      const rows = block.children ? blocksToHtml(block.children) : ''
      return `<table>${rows}</table>`
    }
    case 'table_row': {
      const cells = (block.cells || []).map((c: any[]) => renderRichText(c))
        .map((cell: string) => `<td>${cell}</td>`)
        .join('')
      return `<tr>${cells}</tr>`
    }
    case 'synced_block': {
      const childHtml = block.children ? blocksToHtml(block.children) : ''
      return childHtml
    }
    case 'table_of_contents':
      return ''
    case 'link_to_page':
      return ''
    case 'child_page':
      return ''
    case 'sub_page_link': {
      const subTitle = escapeHtml(block.title || 'Sub Page')
      const subSlug = escapeHtml(block.slug || '')
      return `<p><a href="/posts/${subSlug}" class="in-site-link">${subTitle}</a></p>`
    }
    default:
      return ''
  }
}

function blocksToHtml(blocks: any[], wrapSections = false): string {
  let html = ''
  let i = 0
  while (i < blocks.length) {
    const block = blocks[i]
    const t = block.type

    if (wrapSections && (t === 'heading_1' || t === 'heading_2' || t === 'heading_3')) {
      if (currentSectionId) html += '</div>'
      const headingHtml = blockToHtml(block)
      i++
      const match = headingHtml.match(/id="(h-\d+)"/)
      currentSectionId = match ? match[1] : ''
      html += headingHtml
      if (currentSectionId) html += `<div data-section="${currentSectionId}">`
    } else if (t === 'bulleted_list_item') {
      let listHtml = '<ul>'
      while (i < blocks.length && blocks[i].type === 'bulleted_list_item') {
        listHtml += blockToHtml(blocks[i])
        i++
      }
      listHtml += '</ul>'
      html += listHtml
    } else if (t === 'numbered_list_item') {
      let listHtml = '<ol>'
      while (i < blocks.length && blocks[i].type === 'numbered_list_item') {
        listHtml += blockToHtml(blocks[i])
        i++
      }
      listHtml += '</ol>'
      html += listHtml
    } else {
      html += blockToHtml(block)
      i++
    }
  }
  if (wrapSections && currentSectionId) html += '</div>'
  return html
}
---

<Fragment set:html={blocksToHtml(blocks, true)} />
