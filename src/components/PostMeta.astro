---
import { formatDate } from '../lib/date'

export interface Props {
  title: string
  date: string | null
  series: string | null
  tags: { name: string; color: string }[]
  summary?: string
}

const { title, date, series, tags, summary } = Astro.props
---

<div class="post-meta mb-8 pb-6 border-b border-[var(--border)]">
  <h1 class="text-3xl font-bold mb-4 text-[var(--text)]">{title}</h1>

  <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--text-secondary)]">
    {date && (
      <span class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        {formatDate(date, 'long')}
      </span>
    )}

    {series && (
      <a href={`/series/${series}`} class="flex items-center gap-1 hover:text-[var(--accent)] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        {series}
      </a>
    )}
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 text-xs rounded-full bg-[var(--tag-bg)] text-[var(--tag-text)]">
          {tag.name}
        </span>
      ))}
    </div>
  )}

  {summary && (
    <p class="mt-4 text-[var(--text-secondary)] leading-relaxed">{summary}</p>
  )}
</div>
