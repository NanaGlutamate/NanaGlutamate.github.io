---
import ThemeToggle from './ThemeToggle.astro'

interface HeadingItem {
  depth: number
  text: string
  id: string
}

interface Props {
  headings?: HeadingItem[]
}

const { headings = [] } = Astro.props
const currentPath = Astro.url.pathname
const minDepth = headings.length > 0 ? Math.min(...headings.map(h => h.depth)) : 1

const toyPages = import.meta.glob('/src/pages/toys/*.astro')

const navItems = [
  { label: '文章', href: '/' },
  { label: '系列', href: '/series' },
  ...(Object.keys(toyPages).length > 0 ? [{ label: '其他', href: '/toys' }] : []),
]
---

<aside class="left-sidebar hidden xl:flex flex-col w-[240px] flex-shrink-0 h-screen sticky top-0 bg-[var(--sidebar-bg)] border-r border-[var(--border)]">
  <div class="flex-shrink-0 px-5 pt-8 pb-4">
    <a href="/" class="flex items-center gap-2 px-2 mb-8 text-[var(--text)] hover:text-[var(--accent)] transition-colors">
      <img src="/favicon.png" alt="avatar" class="w-6 h-6 rounded-full" />
      <span class="text-base font-medium">NanaGlutamate</span>
    </a>

    <nav class="mb-6 space-y-0.5">
      {navItems.map((item) => {
        const isActive = item.href === '/'
          ? currentPath === '/'
          : currentPath.startsWith(item.href)
        return (
          <a
            href={item.href}
            class={`block px-2 py-1.5 rounded text-sm font-medium transition-colors ${
              isActive
                ? 'bg-[var(--sidebar-active)] text-[var(--accent)]'
                : 'text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--sidebar-hover)]'
            }`}
          >
            {item.label}
          </a>
        )
      })}
    </nav>

    <div>
      <ThemeToggle />
    </div>

    {headings.length > 0 && (
      <>
        <hr class="border-[var(--border)] my-4" />
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3 px-2">
          目录
        </div>
      </>
    )}
  </div>

  {headings.length > 0 && (
    <nav class="toc-links flex-1 overflow-y-auto space-y-0 px-5 pb-8">
      <span class="toc-indicator"></span>
      {headings.map((h, i) => (
        <a
          href={`#${h.id}`}
          data-toc-link={i}
          class={`toc-link toc-depth-${h.depth - minDepth}`}
        >
          {h.text}
        </a>
      ))}
    </nav>
  )}
</aside>
