---
interface HeadingItem {
  depth: number
  text: string
  id: string
}

interface Props {
  headings: HeadingItem[]
}

const { headings } = Astro.props
const showSidebar = headings.length > 0
const minDepth = headings.length > 0 ? Math.min(...headings.map(h => h.depth)) : 1
---

{showSidebar && (
  <aside class="hidden xl:block w-56 flex-shrink-0">
    <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto sidebar-toc">
      <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3 px-2">
        目录
      </h4>
      <ul class="space-y-0.5 text-sm border-l border-[var(--toc-border)]">
        {headings.map((h, i) => (
          <li>
            <a
              href={`#${h.id}`}
              data-toc-link={i}
              class={`block py-1 pl-3 pr-2 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors border-l-2 -ml-px ${
                h.depth === minDepth
                  ? 'font-medium'
                  : h.depth === minDepth + 1
                    ? 'pl-6'
                    : 'pl-9'
              } border-transparent hover:border-[var(--accent)]`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  (function() {
    const links = document.querySelectorAll('[data-toc-link]')
    if (links.length === 0) return

    const ids = Array.from(links).map(a => a.getAttribute('href')!.slice(1))
    const headings = ids.map(id => document.getElementById(id)).filter(Boolean)

    if (headings.length === 0) return

    const nav = document.querySelector('.sidebar-toc')
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = headings.indexOf(entry.target)
            if (idx === -1) continue
            links.forEach(l => {
              l.classList.remove('!text-[var(--accent)]', '!border-[var(--accent)]')
            })
            const active = links[idx]
            active.classList.add('!text-[var(--accent)]', '!border-[var(--accent)]')
            if (nav) {
              const navRect = nav.getBoundingClientRect()
              const linkRect = active.getBoundingClientRect()
              if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom) {
                active.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
              }
            }
          }
        }
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    )

    headings.forEach(h => observer.observe(h))
  })()
</script>
