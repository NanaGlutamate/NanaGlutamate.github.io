---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostMeta from '../../components/PostMeta.astro'
import BlockRenderer from '../../components/BlockRenderer.astro'
import LeftSidebar from '../../components/LeftSidebar.astro'
import { getCollection } from 'astro:content'

interface HeadingItem {
  depth: number
  text: string
  id: string
}

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { title: rawTitle, date, series, tags, summary, blocks } = post.data
const title = rawTitle.trim()

const headings: HeadingItem[] = []
let hCounter = 0
for (const block of blocks) {
  if (block.type === 'heading_1' || block.type === 'heading_2' || block.type === 'heading_3') {
    const text = (block.rich_text || []).map((rt: any) => rt.plain_text || '').join('')
    if (text) {
      hCounter++
      headings.push({
        depth: parseInt(block.type.split('_')[1]),
        text,
        id: `h-${hCounter}`,
      })
    }
  }
}
---

<BaseLayout title={title} description={summary}>
  <div class="max-w-[1280px] mx-auto xl:pl-5">
    <div class="flex">
      <LeftSidebar {headings} />

      <div class="flex-1 min-w-0 px-4 xl:px-10 py-8">
        <article class="max-w-[680px] mx-auto xl:mx-0 relative">
          <PostMeta {title} {date} {series} {tags} {summary} />
          <div class="prose-custom">
            <BlockRenderer {blocks} />
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  (function() {
    const links = document.querySelectorAll('[data-toc-link]')
    if (links.length === 0) return

    const ids = Array.from(links).map(a => a.getAttribute('href')!.slice(1))
    const headingMap = new Map<string, number>()
    ids.forEach((id, i) => headingMap.set(id, i))

    const headingEls = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]

    links.forEach((link, i) => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const h = headingEls[i]
        if (h) {
          history.pushState(null, '', `#${ids[i]}`)
          h.scrollIntoView({ behavior: 'smooth' })
        }
      })
    })

    const nav = links[0].closest('.toc-links')
    const indicator = nav ? nav.querySelector('.toc-indicator') as HTMLElement : null
    const sections = document.querySelectorAll('[data-section]')

    function refreshActive() {
      let bestId: string | null = null
      let bestTop = Infinity
      for (const section of sections) {
        const rect = section.getBoundingClientRect()
        if (rect.bottom <= 0) continue
        if (rect.top < bestTop) {
          bestTop = rect.top
          bestId = section.getAttribute('data-section')
        }
      }
      links.forEach(l => l.classList.remove('active'))
      if (bestId && headingMap.has(bestId)) {
        const idx = headingMap.get(bestId)!
        const active = links[idx] as HTMLElement
        active.classList.add('active')
        if (nav) {
          const navRect = nav.getBoundingClientRect()
          const linkRect = active.getBoundingClientRect()
          if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom) {
            active.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
          }
        }
        if (indicator) {
          indicator.style.top = active.offsetTop + 'px'
          indicator.style.height = active.offsetHeight + 'px'
        }
      } else if (indicator) {
        indicator.style.top = '0px'
        indicator.style.height = '0px'
      }
    }

    const observer = new IntersectionObserver(
      () => refreshActive(),
      { rootMargin: '0px 0px -60% 0px', threshold: 0 }
    )

    sections.forEach(s => observer.observe(s))
  })();

  // ── Equation copy buttons ──
  document.querySelectorAll('.copy-latex').forEach(btn => {
    btn.addEventListener('click', () => {
      const wrapper = btn.closest('.equation-wrapper') as HTMLElement | null
      if (!wrapper) return
      const expr = wrapper.getAttribute('data-equation') || ''
      navigator.clipboard.writeText(expr).then(() => {
        btn.classList.add('copied')
        setTimeout(() => btn.classList.remove('copied'), 500)
      }).catch(() => {})
    })
  })

  // ── Code copy buttons ──
  document.querySelectorAll('.copy-code').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.closest('.code-block') as HTMLElement | null
      if (!block) return
      const code = block.getAttribute('data-code') || ''
      navigator.clipboard.writeText(code).then(() => {
        btn.classList.add('copied')
        setTimeout(() => btn.classList.remove('copied'), 500)
      }).catch(() => {})
    })
  })

  // ── Mermaid render & toggle ──
  const mermaidBlocks = document.querySelectorAll('.mermaid-block')
  if (mermaidBlocks.length > 0) {
    import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs').then(async (mermaid) => {
      mermaid.default.initialize({ startOnLoad: false, theme: 'default' })
      await mermaid.default.run({ querySelector: '.mermaid' })
      document.querySelectorAll('.mermaid-render').forEach(el => el.classList.add('ready'))

      document.querySelectorAll('.toggle-mermaid').forEach(btn => {
        btn.addEventListener('click', () => {
          const block = btn.closest('.mermaid-block') as HTMLElement | null
          if (!block) return
          const renderView = block.querySelector('.mermaid-render') as HTMLElement | null
          const codeView = block.querySelector('.code-body') as HTMLElement | null
          const iconCode = btn.querySelector('.toggle-icon-code') as HTMLElement | null
          const iconChart = btn.querySelector('.toggle-icon-chart') as HTMLElement | null
          if (!renderView || !codeView) return

          if (renderView.style.display !== 'none') {
            renderView.style.display = 'none'
            codeView.style.display = ''
            if (iconCode) iconCode.style.display = 'none'
            if (iconChart) iconChart.style.display = ''
            btn.setAttribute('title', 'Show diagram')
          } else {
            renderView.style.display = ''
            codeView.style.display = 'none'
            if (iconCode) iconCode.style.display = ''
            if (iconChart) iconChart.style.display = 'none'
            btn.setAttribute('title', 'Show code')
          }
        })
      })
    }).catch(() => {})
  }
</script>
