---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LeftSidebar from '../../components/LeftSidebar.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '../../lib/date'

const posts = await getCollection('posts')
posts.sort((a, b) => {
  const da = a.data.date || '0'
  const db = b.data.date || '0'
  return db.localeCompare(da)
})

const seriesMap = new Map<string, typeof posts>()
for (const post of posts) {
  const s = post.data.series
  if (s) {
    if (!seriesMap.has(s)) seriesMap.set(s, [])
    seriesMap.get(s)!.push(post)
  }
}

const seriesList = Array.from(seriesMap.entries()).sort((a, b) => a[0].localeCompare(b[0]))
---

<BaseLayout title="系列" description="按系列浏览文章">
  <div class="max-w-[1280px] mx-auto">
    <div class="flex">
      <LeftSidebar />

      <div class="flex-1 min-w-0 px-4 xl:px-10 py-8">
        <div class="max-w-[680px] mx-auto xl:mx-0">
          <h1 class="text-2xl font-bold mb-8 text-[var(--text)]" style="font-family: var(--font-sans)">系列</h1>

          {seriesList.length === 0 ? (
            <p class="text-[var(--text-muted)]">暂无系列</p>
          ) : (
            <div class="space-y-8">
              {seriesList.map(([name, seriesPosts]) => (
                <section>
                  <h2 class="text-lg font-semibold mb-3 text-[var(--text)]" style="font-family: var(--font-sans)">{name}</h2>
                  <div>
                    {seriesPosts.map((p) => (
                      <a href={`/posts/${p.data.slug}`} class="series-card">
                        <span class="series-card-title">{p.data.title.trim()}</span>
                        {p.data.date && (
                          <span class="series-card-date">{formatDate(p.data.date)}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
