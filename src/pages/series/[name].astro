---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LeftSidebar from '../../components/LeftSidebar.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '../../lib/date'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const seriesNames = new Set<string>()
  for (const post of posts) {
    if (post.data.series) seriesNames.add(post.data.series)
  }
  return Array.from(seriesNames).map((name) => ({
    params: { name },
    props: { name },
  }))
}

const { name } = Astro.props
const allPosts = await getCollection('posts')
const posts = allPosts
  .filter((p) => p.data.series === name)
  .sort((a, b) => {
    const da = a.data.date || '0'
    const db = b.data.date || '0'
    return db.localeCompare(da)
  })
---

<BaseLayout title={`${name} · 系列`} description={`系列: ${name}`}>
  <div class="max-w-[1280px] mx-auto xl:pl-5">
    <div class="flex">
      <LeftSidebar />

      <div class="flex-1 min-w-0 px-4 xl:px-10 py-8">
        <div class="max-w-[680px] mx-auto xl:mx-0">
          <div class="mb-8">
            <a href="/series" class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors" style="font-family: var(--font-sans)">
              &larr; 所有系列
            </a>
            <h1 class="text-2xl font-bold mt-2 text-[var(--text)]" style="font-family: var(--font-sans)">{name}</h1>
            <p class="text-sm text-[var(--text-muted)] mt-1" style="font-family: var(--font-sans)">{posts.length} 篇文章</p>
          </div>

          <div>
            {posts.map((post) => {
              const metaParts: string[] = []
              if (post.data.date) metaParts.push(formatDate(post.data.date, 'long'))
              post.data.tags.slice(0, 4).forEach((tag: { name: string }) => metaParts.push(tag.name))
              return (
                <a href={`/posts/${post.data.slug}`} class="post-card">
                  <h2 class="post-card-title">{post.data.title.trim()}</h2>
                  {metaParts.length > 0 && (
                    <div class="post-card-meta">
                      {metaParts.map((part, i) => (
                        <>{i > 0 && <span class="post-card-meta-sep">·</span>}<span>{part}</span></>
                      ))}
                    </div>
                  )}
                  {post.data.summary && (
                    <p class="post-card-summary line-clamp-2">{post.data.summary}</p>
                  )}
                </a>
              )
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
