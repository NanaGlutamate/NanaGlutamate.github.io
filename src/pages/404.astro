---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404">
  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <h1 class="text-6xl font-bold text-[var(--text-muted)] mb-4">404</h1>
    <p class="text-lg text-[var(--text-secondary)] mb-8">页面未找到</p>
    <a
      href="/"
      class="inline-block px-6 py-2 rounded-lg bg-[var(--accent)] text-white hover:opacity-90 transition-opacity"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
