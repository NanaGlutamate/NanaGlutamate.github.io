---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="未公开文章">
  <div class="max-w-[680px] mx-auto px-4 py-24 text-center">
    <div class="text-5xl mb-6 text-[var(--text-muted)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h1 class="text-xl font-semibold text-[var(--text)] mb-3" style="font-family: var(--font-sans)">
      未公开文章
    </h1>
    <p class="text-sm text-[var(--text-secondary)] mb-10 leading-relaxed" style="font-family: var(--font-sans)">
      这篇文章尚未发布
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm rounded-lg border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors"
      style="font-family: var(--font-sans)"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      返回首页
    </a>
  </div>
</BaseLayout>
