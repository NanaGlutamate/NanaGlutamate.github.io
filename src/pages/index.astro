---
import BaseLayout from '../layouts/BaseLayout.astro'
import LeftSidebar from '../components/LeftSidebar.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '../lib/date'

const posts = await getCollection('posts')
posts.sort((a, b) => {
  const da = a.data.date || '0'
  const db = b.data.date || '0'
  return db.localeCompare(da)
})
---

<BaseLayout title="文章" description="文章列表">
  <div class="max-w-[1280px] mx-auto xl:pl-5">
    <div class="flex">
      <LeftSidebar />

      <div class="flex-1 min-w-0 px-4 xl:px-10 py-8">
        <div class="max-w-[680px] mx-auto xl:mx-0">
          <h1 class="text-2xl font-bold mb-8 text-[var(--text)]" style="font-family: var(--font-sans)">最新文章</h1>

          {posts.length === 0 ? (
            <div class="text-center py-16 text-[var(--text-muted)]">
              <p class="text-lg mb-2">暂无文章</p>
              <p class="text-sm">运行 <code class="bg-[var(--code-bg)] px-1.5 py-0.5 rounded">npm run fetch</code> 来从 Notion 拉取文章</p>
            </div>
          ) : (
            <div>
              {posts.map((post) => {
                const { slug, title, date, series, tags, summary } = post.data
                const metaParts: string[] = []
                if (date) metaParts.push(formatDate(date))
                if (series) metaParts.push(series)
                tags.slice(0, 4).forEach((tag: { name: string }) => metaParts.push(tag.name))
                return (
                  <a href={`/posts/${slug}`} class="post-card">
                    <h2 class="post-card-title">{title.trim()}</h2>
                    {metaParts.length > 0 && (
                      <div class="post-card-meta">
                        {metaParts.map((part, i) => (
                          <>{i > 0 && <span class="post-card-meta-sep">·</span>}<span>{part}</span></>
                        ))}
                      </div>
                    )}
                    {summary && (
                      <p class="post-card-summary line-clamp-2">{summary}</p>
                    )}
                  </a>
                )
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
