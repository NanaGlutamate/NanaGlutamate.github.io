---
import BaseLayout from '../layouts/BaseLayout.astro'
import LeftSidebar from '../components/LeftSidebar.astro'
import PostCard from '../components/PostCard.astro'
import { getCollection } from 'astro:content'

const posts = await getCollection('posts')
const visiblePosts = posts.filter((p) => p.data.status !== 'sub_page')
visiblePosts.sort((a, b) => {
  const da = a.data.date || '0'
  const db = b.data.date || '0'
  return db.localeCompare(da)
})
---

<BaseLayout title="文章" description="文章列表">
  <div class="max-w-[1280px] mx-auto xl:pl-5">
    <div class="flex">
      <LeftSidebar />

      <div class="flex-1 min-w-0 px-4 xl:px-10 py-8">
        <div class="max-w-[680px] mx-auto xl:mx-0">
          <h1 class="text-2xl font-bold mb-8 text-[var(--text)]" style="font-family: var(--font-sans)">最新文章</h1>

          {visiblePosts.length === 0 ? (
            <div class="text-center py-16 text-[var(--text-muted)]">
              <p class="text-lg mb-2">暂无文章</p>
              <p class="text-sm">运行 <code class="bg-[var(--code-bg)] px-1.5 py-0.5 rounded">npm run fetch</code> 来从 Notion 拉取文章</p>
            </div>
          ) : (
            <div>
              {visiblePosts.map((post) => (
                  <PostCard {...post.data} slug={post.data.slug} />
                ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
