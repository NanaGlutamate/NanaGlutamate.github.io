---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="小玩具" description="小玩具和小工具">
  <div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-8 text-[var(--text)]">小玩具</h1>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="p-6 rounded-xl bg-[var(--card-bg)] border border-[var(--border)] text-center">
        <div class="text-3xl mb-3">🔧</div>
        <h3 class="font-semibold text-[var(--text)] mb-1">更多玩具即将上线</h3>
        <p class="text-sm text-[var(--text-muted)]">在 <code class="bg-[var(--code-bg)] px-1 py-0.5 rounded">src/pages/toys/</code> 下添加自定义页面</p>
      </div>
    </div>
  </div>
</BaseLayout>
